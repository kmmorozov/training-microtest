# Dovecot 2.4: сначала подтвердите major version через dovecot --version.
# В 2.4 mailbox driver/path и TLS file options отделены от синтаксиса 2.3.
protocols = imap
# Maildir хранится в домашнем каталоге пользователя.
mail_driver = maildir
mail_path = ~/Maildir
ssl = required
# Full chain публичен; server private key имеет минимальные owner/mode.
ssl_server_cert_file = /etc/dovecot/private/fullchain.pem
ssl_server_key_file = /etc/dovecot/private/server.key
