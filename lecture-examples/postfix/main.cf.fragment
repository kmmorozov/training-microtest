# Фрагмент /etc/postfix/main.cf для локального домена example.test.
# Не заменяет package config; перед reload выполнить postfix check и postconf -n.
# FQDN и домен должны согласовываться с A/PTR/MX и TLS certificate.
myhostname = mail.example.test
mydomain = example.test
myorigin = $mydomain
# Эти destinations доставляются локально, а не relay во внешний домен.
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain
# all допустимо только вместе с firewall и корректной relay policy.
inet_interfaces = all
# Только loopback и management/lab subnet считаются доверенными relay clients.
mynetworks = 127.0.0.0/8, [::1]/128, 192.0.2.0/24
# Ключевой запрет open relay: посторонние destinations отклоняются.
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
