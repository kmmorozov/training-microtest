// Добавьте в /etc/bind/named.conf.local.
// Абсолютные пути исключают неоднозначность package working directory.
// X заменить до named-checkconf/named-checkzone.
zone "example.test" {
    type master;
    file "/etc/bind/db.example.test";
};
zone "X.168.192.in-addr.arpa" {
    // Reverse zone обслуживает только выбранную /24 лабораторную сеть.
    type master;
    file "/etc/bind/db.192.168.X";
};
