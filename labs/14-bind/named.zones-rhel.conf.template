// Добавьте в /etc/named.rfc1912.zones.
// Относительные file paths разрешаются относительно directory из named.conf
// (в типовой RHEL-like установке — /var/named). X заменить до checkconf.
zone "example.test" {
    // primary/master означает локально редактируемый исходный zone file.
    type master;
    file "db.example.test";
};
zone "X.168.192.in-addr.arpa" {
    // Для 192.168.X.0/24 reverse zone имеет вид X.168.192.in-addr.arpa.
    type master;
    file "db.192.168.X";
};
