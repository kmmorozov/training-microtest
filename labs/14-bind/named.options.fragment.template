// Вставьте эти директивы в СУЩЕСТВУЮЩИЙ options { ... }.
// Не создавайте второй блок options.
// До reload заменить X и выполнить named-checkconf.
// IPv4 listener ограничен loopback и адресом DNS в lab LAN.
listen-on port 53 { 127.0.0.1; 192.168.X.53; };
// IPv6 в схеме стенда не используется; это не рекомендация для production.
listen-on-v6 { none; };
// Запросы принимаются только локально и от лабораторной подсети.
allow-query { 127.0.0.1; 192.168.X.0/24; };
// Статический одиночный authoritative server не отдает AXFR/IXFR.
allow-transfer { none; };
// Сервер отвечает только из своих зон и не является open resolver.
recursion no;
