#!/usr/bin/env bash
# Read-only базовая диагностика готового iRedMail stack лабораторной 17.
# Не запускает installer и не меняет Postfix/Dovecot/internal databases.
set -euo pipefail

# MAIL_HOST используется DNS/SNI/name verification; MAIL_IP — для reverse lookup.
MAIL_HOST='mail.example.test'
MAIL_IP='192.168.X.25'
CA_FILE='<CA-file>'
case "$MAIL_IP$CA_FILE" in *X*|*'<'*) echo "Подставьте MAIL_IP и CA_FILE" >&2; exit 2;; esac

# Сначала общие зависимости: FQDN, synchronized time, A/PTR/MX и NSS.
hostname -f
timedatectl
dig +short "$MAIL_HOST" A
dig +short -x "$MAIL_IP"
dig +short example.test MX
getent ahostsv4 "$MAIL_HOST"
# Затем transport ownership и отсутствие failed systemd units.
sudo ss -lntp | grep -E ':(25|587|993|443) '
sudo systemctl --failed
sudo systemctl status postfix dovecot --no-pager
# -n показывает effective/non-default config без печати vendor defaults целиком.
sudo postconf -n | sed -n '1,100p'
sudo doveconf -n | sed -n '1,120p'

# SMTP/25 и submission/587 используют STARTTLS; IMAPS/HTTPS начинают с TLS.
for spec in 'smtp:25' 'smtp:587' 'tls:993' 'tls:443'; do
    mode=${spec%%:*}
    port=${spec##*:}
    if [ "$mode" = smtp ]; then starttls='-starttls smtp'; else starttls=''; fi
    # SC2086 здесь намеренно разделяет пустую строку или два аргумента -starttls smtp.
    # shellcheck disable=SC2086
    openssl s_client $starttls -connect "$MAIL_HOST:$port" -servername "$MAIL_HOST" \
        -CAfile "$CA_FILE" -verify_hostname "$MAIL_HOST" </dev/null 2>/dev/null |
        # Каждый endpoint обязан вернуть успешное trust/name verification.
        grep 'Verify return code: 0 (ok)'
done
