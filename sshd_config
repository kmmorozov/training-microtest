# Самостоятельный keys-only пример. Перед применением создайте группу ssh-users,
# добавьте администратора и проверьте вход во второй сессии.
# Никогда не закрывайте текущую сессию до `sshd -t -f ./sshd_config` и успешного
# входа в новой. В production предпочтительнее фрагмент sshd_config.d из lab 18.

# Демон слушает стандартный TCP-порт на всех IPv4-адресах; IPv6 здесь отключен.
Port 22
AddressFamily any
ListenAddress 0.0.0.0
# Root и все парольные/keyboard-interactive входы запрещены: остается public key.
PermitRootLogin no
PasswordAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
KbdInteractiveAuthentication no
# PAM остается включенным для account/session policy дистрибутива.
UsePAM yes
# Даже с валидным ключом войдут только участники заранее созданной группы.
AllowGroups ssh-users
# Ограничения уменьшают время и число попыток перебора до аутентификации.
MaxAuthTries 3
LoginGraceTime 1m
# Закрывать зависшие соединения после двух пропущенных keepalive по 300 секунд.
ClientAliveInterval 300
ClientAliveCountMax 2
# X11 отключен; TCP forwarding разрешен по сценарию курса — отключите, если не нужен.
X11Forwarding no
AllowTcpForwarding yes
# Начинать вероятностный отказ после 10 неаутентифицированных сессий, полный — при 60.
MaxStartups 10:30:60
# Отключение сжатия уменьшает поверхность атак и редко вредит современным сетям.
Compression no
